          "kode_slide": "haid-menstruasi",
          "judul_slide": "Haid (menstruasi)",
          "gambar": "haid-menstruasi.webp",
          "text": "Haid ialah darah yang keluar daripada rahim wanita dalam keadaan sihat, bukan disebabkan sakit atau bersalin. Ia adalah kitaran semula jadi yang ditetapkan oleh Allah bagi wanita.",
          "arab": "إِذَا أَقْبَلَتِ الْحَيْضَةُ فَدَعِي الصَّلَاةَ، وَإِذَا أَدْبَرَتْ فَاغْتَسِلِي وَصَلِّي",
          "latin": "Idzā aqbalatil-ḥaiḍatu fa da'īṣ-ṣalāh, wa idzā adbarat faghtasilī wa ṣallī",
          "terjemah": "Apabila haid datang, tinggalkanlah solat. Dan apabila haid telah berhenti, mandilah kemudian solatlah",
          "sumber": "HR. Bukhari",
          "suara": "haid-menstruasi.mp3"
        }
      ]
    },
    "ur": {
      "judul_konten": "غسل واجب ہونے کے اسباب",
