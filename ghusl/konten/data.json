      "slide_show": [
        {
          "kode_slide": "haid-menstruasi",
          "judul_slide": "Haid (menstruasi)",
          "gambar": "haid-menstruasi.webp",
          "text": "Haid adalah darah yang keluar dari rahim wanita dalam kondisi sehat, bukan karena sakit atau melahirkan. Ini adalah siklus alami yang Allah tetapkan bagi wanita.",
          "arab": "إِذَا أَقْبَلَتِ الْحَيْضَةُ فَدَعِي الصَّلَاةَ، وَإِذَا أَدْبَرَتْ فَاغْتَسِلِي وَصَلِّي",
          "latin": "Idzā aqbalatil-ḥaiḍatu fa da'īṣ-ṣalāh, wa idzā adbarat faghtasilī wa ṣallī",
          "terjemah": "Apabila haid datang, tinggalkanlah sholat. Dan apabila haid telah berhenti, mandilah kemudian sholatlah",
          "sumber": "HR. Bukhari",
          "suara": "haid-menstruasi.mp3"
        }
      ]
    },
    "en": {
      "judul_konten": "Reasons for Obligatory Bath (Ghusl)",
      "deskripsi_konten": "A list of conditions that make ghusl obligatory (janabah, menstruation, postnatal bleeding, etc.)",
      "slide_show": [
        {
          "kode_slide": "haid-menstruasi",
          "judul_slide": "Menstruation (Haid)",
          "gambar": "haid-menstruasi.webp",
          "text": "Menstruation is blood that flows from a healthy woman's womb, not caused by illness or childbirth. It is a natural cycle that Allah has ordained for women.",
          "arab": "إِذَا أَقْبَلَتِ الْحَيْضَةُ فَدَعِي الصَّلَاةَ، وَإِذَا أَدْبَرَتْ فَاغْتَسِلِي وَصَلِّي",
          "latin": "Idzā aqbalatil-ḥaiḍatu fa da'īṣ-ṣalāh, wa idzā adbarat faghtasilī wa ṣallī",
          "terjemah": "When menstruation begins, leave the prayer. And when it ends, take a bath (ghusl) and then pray.",
          "sumber": "Narrated by Bukhari",
          "suara": "haid-menstruasi.mp3"
        }
      ]
    },
    "ms": {
      "judul_konten": "Sebab-sebab Mandi Wajib",
      "deskripsi_konten": "Senarai keadaan yang mewajibkan mandi (junub, haid, nifas, dan sebagainya)",
      "slide_show": [
