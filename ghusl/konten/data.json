      "slide_show": [
        {
          "kode_slide": "haid-menstruasi",
          "judul_slide": "حیض (ماہواری)",
          "gambar": "haid-menstruasi.webp",
          "text": "حیض وہ خون ہے جو صحت مند عورت کے رحم سے خارج ہوتا ہے، یہ بیماری یا زچگی کی وجہ سے نہیں ہوتا۔ یہ ایک فطری چکر ہے جو اللہ تعالیٰ نے عورتوں کے لیے مقرر فرمایا ہے۔",
          "arab": "إِذَا أَقْبَلَتِ الْحَيْضَةُ فَدَعِي الصَّلَاةَ، وَإِذَا أَدْبَرَتْ فَاغْتَسِلِي وَصَلِّي",
          "latin": "Idzā aqbalatil-ḥaiḍatu fa da'īṣ-ṣalāh, wa idzā adbarat faghtasilī wa ṣallī",
          "terjemah": "جب حیض شروع ہو جائے تو نماز چھوڑ دو، اور جب ختم ہو جائے تو غسل کر کے نماز پڑھو",
          "sumber": "روایت بخاری",
          "suara": "haid-menstruasi.mp3"
        }
      ]
    }
